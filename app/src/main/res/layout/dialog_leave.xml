<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <!-- Icon with breathing pulse ring -->
    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp">

        <View
            android:id="@+id/pulseRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring" />

        <FrameLayout
            android:id="@+id/leaveIconBg"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_leave_icon">

            <ImageView
                android:id="@+id/leaveIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_leave"
                app:tint="@color/danger" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/leaveTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/leave_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/leaveMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Primary: stay (safe choice) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stayButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:elevation="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="58dp"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:stateListAnimator="@null"
        android:text="@string/stay_here"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/royal_blue"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_shield"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconSize="22dp"
        app:iconTint="#FFFFFF" />

    <!-- Secondary: leave, with animated gradient border -->
    <FrameLayout
        android:id="@+id/leaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:minHeight="58dp">

        <TextView
            android:id="@+id/leaveButtonText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            android:textColor="@color/danger_dark"
            android:textSize="16.5sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
